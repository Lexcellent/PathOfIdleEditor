<Window x:Class="PathOfIdleEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Path of Idle 独立编辑器" Height="860" Width="1080"
        MinHeight="720" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="#0B1120" Foreground="#E5E7EB" FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#111827" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#172033" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B3851" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <!-- TextBlock 保持继承父控件的 Foreground，避免下拉框浅色背景中仍被强制显示为白色。 -->
    <Style TargetType="Label"><Setter Property="Foreground" Value="#CBD5E1" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0F172A" /><Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="CaretBrush" Value="#F8FAFC" /><Setter Property="SelectionBrush" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="Padding" Value="9,6" /><Setter Property="Margin" Value="4" />
    </Style>
    <Style TargetType="ComboBox">
      <!-- 系统 ComboBox 模板在部分 Windows 主题下固定使用浅色输入区域，因此采用深色文字保证对比度。 -->
      <Setter Property="Background" Value="#F8FAFC" /><Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="Padding" Value="8,5" /><Setter Property="Margin" Value="4" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <!-- 自定义选项模板，避免 Windows 系统主题用浅色高亮背景覆盖应用配色。 -->
      <Setter Property="Background" Value="#0F172A" /><Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="Padding" Value="10,7" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" SnapsToDevicePixels="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#1E40AF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#075985" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemBorder" Property="Background" Value="#111827" />
                <Setter Property="Foreground" Value="#64748B" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#CBD5E1" /><Setter Property="Padding" Value="18,9" /><Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="HeaderBorder" Background="#172033" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#23314A" /><Setter Property="Foreground" Value="White" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#1D4ED8" /><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#60A5FA" /><Setter Property="Foreground" Value="White" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#64748B" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1D4ED8" /><Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="16,8" /><Setter Property="Margin" Value="4" /><Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#0F172A" /><Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#25324A" /><Setter Property="RowBackground" Value="#0F172A" /><Setter Property="AlternatingRowBackground" Value="#141E31" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#1E293B" /><Setter Property="Foreground" Value="#E2E8F0" /><Setter Property="Padding" Value="8" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#E5E7EB" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1D4ED8" /><Setter Property="Foreground" Value="White" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,0,12" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Background="#14213A">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Path of Idle 独立编辑器" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="规则实时读取自当前游戏；修改通过无界面 BepInEx 桥接写入存档。" Foreground="#94A3B8" Margin="0,5,0,0" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="RefreshButton" Content="连接 / 刷新游戏数据" Click="RefreshButton_Click" MinWidth="170" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#64748B" Margin="0,0,9,0" />
        <TextBlock x:Name="StatusText" Text="请启动游戏并进入一个游戏存档，然后连接。" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <TabControl Background="Transparent" BorderThickness="0">
      <TabItem Header="装备生成器">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="基础规则" FontSize="18" FontWeight="SemiBold" Margin="4,0,4,10" />
                <Label Grid.Row="1" Content="搜索装备名称或 ID" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="EquipmentSearchText" TextChanged="EquipmentSearchText_TextChanged" />
                <Label Grid.Row="2" Content="装备模板" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EquipmentTemplateCombo" DisplayMemberPath="Display" SelectionChanged="EquipmentSelectionChanged" />
                <Label Grid.Row="3" Content="该装备支持的品级" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="QualityCombo" DisplayMemberPath="Display" SelectionChanged="EquipmentSelectionChanged" />
                <Label Grid.Row="4" Content="合法装备等级" />
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="EquipmentLevelCombo" SelectionChanged="EquipmentSelectionChanged" IsTextSearchEnabled="True" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="2">
                  <TextBlock Text="词条编辑" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="AffixRuleText" Text="选择装备、品级和等级后读取游戏词条池。"
                             Foreground="#94A3B8" Margin="0,4,0,10" TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" x:Name="AffixQualityCombo" DisplayMemberPath="Display" SelectionChanged="AffixQualityCombo_SelectionChanged" />
                  <ComboBox Grid.Column="1" x:Name="AllowedAffixCombo" DisplayMemberPath="Display" MinWidth="300" />
                  <Button Grid.Column="2" Content="添加词条" Click="AddAffixButton_Click" />
                  <Button Grid.Column="3" Content="删除选中" Click="RemoveAffixButton_Click" Background="#B91C1C" />
                </Grid>
                <DataGrid Grid.Row="2" Grid.ColumnSpan="2" x:Name="AffixesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" MinHeight="240"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True" RowHeight="38" ColumnHeaderHeight="40" FontSize="14">
                  <DataGrid.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#475569" BorderThickness="0,1,0,1" Padding="10,6" Margin="0,6,0,2">
                            <Border.Style>
                              <Style TargetType="Border">
                                <!-- 普通词条使用中性灰；未知的新档位也安全回退到该配色。 -->
                                <Setter Property="Background" Value="#293241" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Name}" Value="精良">
                                    <Setter Property="Background" Value="#17375E" />
                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Name}" Value="稀有">
                                    <Setter Property="Background" Value="#493A16" />
                                    <Setter Property="BorderBrush" Value="#D97706" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Name}" Value="神话">
                                    <!-- 沿用游戏的神话红色边框，并提高文字与深色背景的对比度。 -->
                                    <Setter Property="Background" Value="#4A1D22" />
                                    <Setter Property="BorderBrush" Value="#B32832" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#CBD5E1" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="精良">
                                      <Setter Property="Foreground" Value="#60A5FA" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Name}" Value="稀有">
                                      <Setter Property="Foreground" Value="#FBBF24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Name}" Value="神话">
                                      <Setter Property="Foreground" Value="#F87171" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </DataTemplate>
                      </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                  </DataGrid.GroupStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="词条 ID" Binding="{Binding Id}" IsReadOnly="True" Width="Auto" MinWidth="90" />
                    <DataGridTextColumn Header="词条描述" Binding="{Binding Name}" IsReadOnly="True" Width="Auto" MinWidth="260" MaxWidth="900" />
                    <DataGridTextColumn Header="类别" Binding="{Binding QualityName}" IsReadOnly="True" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="等级（可编辑）" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="130" />
                    <DataGridTextColumn Header="数值（留空随机）" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="Auto" MinWidth="150" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
            <Button Content="生成装备并加入背包" Click="GenerateEquipmentButton_Click" Height="46" FontSize="16" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="物品编辑器">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- 类型标签同时过滤新增候选和当前背包，避免不同物品规则混在一起。 -->
          <TabControl x:Name="InventoryTypeTabs" Height="47" Margin="0,0,0,10" Background="Transparent" BorderThickness="0"
                      SelectionChanged="InventoryTypeTabs_SelectionChanged">
            <TabItem Header="资源" Tag="1" IsSelected="True" />
            <TabItem Header="工具 / 宝箱" Tag="10" />
            <TabItem Header="符文" Tag="3" />
            <TabItem Header="奇物" Tag="5" />
          </TabControl>
          <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="140" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.ColumnSpan="4" Text="增加物品到背包" FontSize="18" FontWeight="SemiBold" Margin="4,0,4,10" />
              <Label Grid.Row="1" Content="搜索名称或 ID" />
              <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="InventoryTemplateSearchText" TextChanged="InventoryTemplateSearchText_TextChanged" />
              <Label Grid.Row="2" Content="物品" />
              <ComboBox Grid.Row="2" Grid.Column="1" x:Name="InventoryTemplateCombo" DisplayMemberPath="Display" />
              <Label Grid.Row="2" Grid.Column="2" Content="增加数量" />
              <TextBox Grid.Row="2" Grid.Column="3" x:Name="AddInventoryCountText" Text="1" />
            </Grid>
          </Border>

          <Grid Grid.Row="2" Margin="4,0,4,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="当前背包物品" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="InventorySearchText" TextChanged="InventorySearchText_TextChanged"
                     ToolTip="搜索名称、ID 或类别" Margin="18,0,4,0" />
          </Grid>
          <DataGrid Grid.Row="3" x:Name="InventoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    RowHeight="38" ColumnHeaderHeight="40">
            <DataGrid.Columns>
              <DataGridTextColumn Header="存放位置" Binding="{Binding ContainerName}" IsReadOnly="True" Width="115" />
              <DataGridTextColumn Header="槽位" Binding="{Binding FieldIndex}" IsReadOnly="True" Width="75" />
              <DataGridTextColumn Header="类别" Binding="{Binding TypeName}" IsReadOnly="True" Width="90" />
              <DataGridTextColumn Header="物品 ID" Binding="{Binding Id}" IsReadOnly="True" Width="100" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="220" />
              <DataGridTextColumn Header="品质" Binding="{Binding Quality}" IsReadOnly="True" Width="80" />
              <DataGridTextColumn Header="等级" Binding="{Binding Level}" IsReadOnly="True" Width="80" />
              <DataGridTextColumn Header="数量（可编辑）" Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="140" />
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Content="增加选中物品到背包" Click="AddInventoryButton_Click" Height="46" FontSize="16" />
            <Button Grid.Column="1" Content="应用选中物品数量（0 表示删除）" Click="ApplyInventoryCountButton_Click" Height="46" FontSize="16" />
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="崇拜者">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Label Content="崇拜者等级" />
              <TextBox Grid.Column="1" x:Name="LordLevelText" />
              <TextBlock Grid.Column="2" x:Name="LordLevelRuleText" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <DataGrid Grid.Row="1" x:Name="LordJobsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                    SelectionChanged="LordJobsGrid_SelectionChanged" Margin="0,0,0,10"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridTextColumn Header="职业 ID" Binding="{Binding JobId}" IsReadOnly="True" Width="80" />
              <DataGridTextColumn Header="职业魔偶" Binding="{Binding JobName}" IsReadOnly="True" Width="*" MinWidth="150" />
              <DataGridTextColumn Header="等级" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="85" />
              <DataGridTextColumn Header="等级上限" Binding="{Binding MaximumLevel}" IsReadOnly="True" Width="90" />
              <DataGridTextColumn Header="崇拜者要求" Binding="{Binding RequiredLordLevel}" IsReadOnly="True" Width="105" />
              <DataGridTextColumn Header="属性总点" Binding="{Binding TotalAttributePoints}" IsReadOnly="True" Width="90" />
              <DataGridTextColumn Header="力量加成" Binding="{Binding Strength, UpdateSourceTrigger=PropertyChanged}" Width="95" />
              <DataGridTextColumn Header="力量范围" Binding="{Binding StrengthRange}" IsReadOnly="True" Width="85" />
              <DataGridTextColumn Header="敏捷加成" Binding="{Binding Dexterity, UpdateSourceTrigger=PropertyChanged}" Width="95" />
              <DataGridTextColumn Header="敏捷范围" Binding="{Binding DexterityRange}" IsReadOnly="True" Width="85" />
              <DataGridTextColumn Header="智力加成" Binding="{Binding Intelligence, UpdateSourceTrigger=PropertyChanged}" Width="95" />
              <DataGridTextColumn Header="智力范围" Binding="{Binding IntelligenceRange}" IsReadOnly="True" Width="85" />
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Grid.Row="2" Margin="4,0,4,8">
            <TextBlock Text="选中职业的天赋 / 技能等级加成" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="LordTalentRuleText" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <DataGrid Grid.Row="3" x:Name="LordTalentsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridTextColumn Header="天赋 ID" Binding="{Binding TalentId}" IsReadOnly="True" Width="100" />
              <DataGridTextColumn Header="类型" Binding="{Binding Kind}" IsReadOnly="True" Width="110" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="260" />
              <DataGridTextColumn Header="等级加成（可编辑）" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="170" />
              <DataGridTextColumn Header="当前上限" Binding="{Binding MaximumLevel}" IsReadOnly="True" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
          <Button Grid.Row="4" Content="应用崇拜者及已修改的职业魔偶" Click="ApplyLordButton_Click" Height="46" FontSize="16" Margin="4,12,4,4" />
        </Grid>
      </TabItem>

      <TabItem Header="角色编辑器">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Label Content="角色" /><ComboBox Grid.Column="1" Grid.ColumnSpan="3" x:Name="HeroCombo" DisplayMemberPath="Display" SelectionChanged="HeroCombo_SelectionChanged" />
              <Label Grid.Row="1" Content="名称" /><TextBox Grid.Row="1" Grid.Column="1" x:Name="HeroNameText" />
              <Label Grid.Row="1" Grid.Column="2" Content="等级（读取游戏上限）" /><TextBox Grid.Row="1" Grid.Column="3" x:Name="HeroLevelText" />
              <Label Grid.Row="2" Content="力量（STR）" /><TextBox Grid.Row="2" Grid.Column="1" x:Name="StrengthText" />
              <Label Grid.Row="2" Grid.Column="2" Content="敏捷（DEX）" /><TextBox Grid.Row="2" Grid.Column="3" x:Name="DexterityText" />
              <Label Grid.Row="3" Content="智力（INT）" /><TextBox Grid.Row="3" Grid.Column="1" x:Name="IntelligenceText" />
              <Label Grid.Row="3" Grid.Column="2" Content="剩余技能点" /><TextBox Grid.Row="3" Grid.Column="3" x:Name="RemainingPointsText" />
              <Label Grid.Row="4" Content="赐福等级" /><ComboBox Grid.Row="4" Grid.Column="1" x:Name="BlessingLevelCombo" />
              <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Text="合法等级读取自当前游戏；0 表示清除赐福。" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0" />
              <Label Grid.Row="5" Content="角色品级" />
              <ComboBox Grid.Row="5" Grid.Column="1" x:Name="HeroQualityCombo" DisplayMemberPath="Display" />
              <TextBlock Grid.Row="5" Grid.Column="2" Text="调用游戏原生扭曲核心并重算属性" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,8,0" TextWrapping="Wrap" />
              <Button Grid.Row="5" Grid.Column="3" Content="应用品级并重算" Click="ChangeHeroQualityButton_Click" Padding="14,8"
                      ToolTip="单独应用品级；游戏会重新生成该品级的基础属性和每级成长，并同步技能点。" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="4,0,4,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="112" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="每级属性成长" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="GrowthRuleText" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="使用血肉结晶重新随机" Click="RerollGrowthButton_Click" Padding="18,8" Margin="12,0,0,0" />
            </Grid>
            <DataGrid Grid.Row="1" x:Name="GrowthGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,10">
              <DataGrid.Columns>
                <DataGridTextColumn Header="属性" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="合法范围" Binding="{Binding ValueRange}" IsReadOnly="True" Width="150" />
                <DataGridTextColumn Header="每级成长（可编辑）" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="190" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="技能树、异化技能与启迪天赋" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="ExtraTalentRuleText" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="按游戏规则同步异化技能" Click="SyncAlienSkillsButton_Click" Padding="14,8" Margin="0,0,8,0"
                        ToolTip="按当前角色容量清理无效或超额异化技能，并由游戏随机补齐可用异化技能。" />
                <Button Content="消耗血肉结晶随机启迪天赋" Click="InspireHeroButton_Click" Padding="14,8"
                        ToolTip="调用神殿原生流程，校验设施、数量上限和材料后，随机新增一个其他职业天赋。" />
              </StackPanel>
            </Grid>
          </Grid>
          <DataGrid Grid.Row="2" x:Name="TalentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="300"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridTextColumn Header="位置" Binding="{Binding SlotId}" IsReadOnly="True" Width="75" />
              <DataGridTextColumn Header="类型" Binding="{Binding Kind}" IsReadOnly="True" Width="100" />
              <DataGridTemplateColumn Header="技能 / 天赋（技能可更换）" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding SkillOptions}" DisplayMemberPath="Display" SelectedValuePath="TalentId"
                              SelectedValue="{Binding TalentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectionChanged="SkillOption_SelectionChanged" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="合法范围" Binding="{Binding LevelRange}" IsReadOnly="True" Width="105" />
              <DataGridTextColumn Header="等级（可编辑）" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="130" />
            </DataGrid.Columns>
          </DataGrid>
          <Button Grid.Row="3" Content="应用角色、每级属性成长和技能树修改" Click="ApplyHeroButton_Click" Height="46" FontSize="16" Margin="4,12,4,4" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
